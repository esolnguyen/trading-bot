AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=
# For Azure AI Foundry (*.services.ai.azure.com): not used, kept for traditional Azure OpenAI only
AZURE_API_VERSION=2024-08-01-preview

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# Leave empty to use built-in defaults.
# Demo futures: https://demo-fapi.binance.com
# Real futures: https://fapi.binance.com
BINANCE_BASE_URL=

# BOT_MODE: off | dry_run | live
#   off     → master kill switch, always HOLD
#   dry_run → simulate orders, log what would have happened
#   live    → place real orders
BOT_MODE=dry_run
MAX_ORDER_USDT=50
FUTURES_LEVERAGE=10
TRADING_SYMBOLS=BTCUSDT,ETHUSDT

# ── trading_bot (LangGraph agent) ────────────────────────────────────────────
# Model used by the ReAct agent. Must be a model langchain-anthropic accepts.
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# Primary timeframe the agent focuses on each tick (it may pull others via
# the analysis MCP).
TRADING_TIMEFRAME=15m
# How often the decision loop wakes up. 900 = every 15 minutes.
TRADING_DECISION_INTERVAL_SECONDS=900
# Minimum conviction (1-10) for LONG/SHORT; below this the decision is gated
# to HOLD regardless of what the agent emits.
TRADING_MIN_CONVICTION=6
# Recursion cap inside the ReAct graph. 12 ≈ enough tool calls for a
# thorough multi-signal analysis; raise if the agent truncates reasoning.
LLM_MAX_ITERATIONS=12

CRYPTOCOMPARE_API_KEY=
CHROMA_PATH=./chroma_db
NEWS_INTERVAL=900
MACRO_INTERVAL=1800
OHLCV_INTERVAL=3600

AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=
# For Azure AI Foundry (*.services.ai.azure.com): not used, kept for traditional Azure OpenAI only
AZURE_API_VERSION=2024-08-01-preview

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRODUCT=usdt_futures
BINANCE_TESTNET=true
# Leave empty to use built-in defaults.
# Demo futures: https://demo-fapi.binance.com
# Real futures: https://fapi.binance.com
BINANCE_BASE_URL=

BOT_ENABLED=true
BOT_DRY_RUN=true
BOT_INTERVAL_SECONDS=300
MAX_ORDER_USDT=50
MODEL_SUPPORTS_VISION=false

CRYPTOCOMPARE_API_KEY=
CHROMA_PATH=./chroma_db
NEWS_INTERVAL=900
MACRO_INTERVAL=1800
OHLCV_INTERVAL=3600

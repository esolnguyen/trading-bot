AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=
# For Azure AI Foundry (*.services.ai.azure.com): not used, kept for traditional Azure OpenAI only
AZURE_API_VERSION=2024-08-01-preview

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# Leave empty to use built-in defaults.
# Demo futures: https://demo-fapi.binance.com
# Real futures: https://fapi.binance.com
BINANCE_BASE_URL=

# BOT_MODE: off | dry_run | live
#   off     → master kill switch, always HOLD
#   dry_run → simulate orders, log what would have happened
#   live    → place real orders
BOT_MODE=dry_run
MAX_ORDER_USDT=50
MODEL_SUPPORTS_VISION=false
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
SINGLE_SYMBOL_DECISION=true

# TRADING_ENGINE: which decision path drives the main loop.
#   scorer       → deterministic signal scorer, no LLM calls
#   llm_skills   → LLM with playbook skills + chart only (no indicators/ML/RAG)
#   llm_enriched → LLM with skills + indicators + ML + RAG (full context)
TRADING_ENGINE=llm_enriched
# Comma-separated skill names (see src/services/llm_trader/skills/).
# Applied to both the main loop (llm_skills/llm_enriched) and the standalone llm_trader.
TRADER_SKILLS=candlestick,technical-basic,smc,crypto-derivatives,perp-funding-basis

# Timeframe tuning (TIMEFRAME, FUTURES_LEVERAGE, SCORING_*, SL/TP, RSI,
# trailing stop, choppiness, etc.) lives in config/presets.json — apply with:
#   python scripts/apply_preset.py <preset_name>

# ── llm_trader (standalone LLM-driven futures module in llm_trader/) ─────────
# Overrides the shared vars above; falls back to them if not set.
LLM_TRADER_SYMBOL=BTCUSDT
LLM_TRADER_LEVERAGE=10
LLM_TRADER_ORDER_USDT=50
LLM_TRADER_DRY_RUN=true
# How often to re-evaluate (seconds). 900 = every 15 minutes.
LLM_TRADER_INTERVAL_SECONDS=900
# Number of candles sent to the LLM (200 × 15m ≈ 2 days). Lower = cheaper prompts.
LLM_TRADER_KLINE_LIMIT=200
# Safety: minimum LLM confidence (1-10) to execute a trade. Below this → HOLD.
LLM_TRADER_MIN_CONFIDENCE=3
# Kill switch: halt trading after N consecutive losing trades.
LLM_TRADER_MAX_CONSECUTIVE_LOSSES=3
# Kill switch: halt trading when daily account drawdown exceeds this %.
LLM_TRADER_MAX_DAILY_LOSS_PCT=0.05

CRYPTOCOMPARE_API_KEY=
CHROMA_PATH=./chroma_db
NEWS_INTERVAL=900
MACRO_INTERVAL=1800
OHLCV_INTERVAL=3600

# Signal scorer tuning (weights/thresholds) lives in config/presets.json —
# only active when TRADING_ENGINE=scorer.
